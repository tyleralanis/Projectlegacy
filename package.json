{
  "name": "project-legacy",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "description": "Offline-first, deterministic life and dynasty simulation for iOS.",
  "dependencies": {
    "@expo/ui": "~57.0.12",
    "@project-legacy/legacy-ai": "file:modules/legacy-ai",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.16",
    "expo-web-browser": "~57.0.2",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "ajv": "^8.20.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^57.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stress": "vitest run src/engine/__tests__/stress.test.ts --reporter=verbose",
    "validate:schemas": "node scripts/validate-schemas.mjs && node scripts/validate-life-systems.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm validate:schemas",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:development": "pnpm dlx eas-cli@22.0.0 build --platform ios --profile development",
    "build:preview": "pnpm dlx eas-cli@22.0.0 build --platform ios --profile preview",
    "build:production": "pnpm dlx eas-cli@22.0.0 build --platform ios --profile production",
    "submit:ios": "pnpm dlx eas-cli@22.0.0 submit --platform ios --profile production"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.19.0"
}
