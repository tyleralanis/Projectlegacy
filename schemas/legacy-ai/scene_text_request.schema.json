{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-legacy.scene-text-request.schema.json",
  "type": "object",
  "required": [
    "requestId",
    "sceneType",
    "facts",
    "fallbackNarrative",
    "fallbackNPCSpeech"
  ],
  "properties": {
    "requestId": {
      "type": "string"
    },
    "sceneType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "facts": {
      "type": "object"
    },
    "persona": {
      "type": "object"
    },
    "fallbackNarrative": {
      "type": "string",
      "maxLength": 1000
    },
    "fallbackNPCSpeech": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "maxLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  },
  "additionalProperties": false
}
