{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-legacy.scene-response.schema.json",
  "type": "object",
  "required": [
    "requestId",
    "modeUsed",
    "narrative",
    "npcSpeech",
    "interpretation",
    "safetyFlags"
  ],
  "properties": {
    "requestId": {
      "type": "string"
    },
    "modeUsed": {
      "enum": [
        "baseline",
        "foundation_models"
      ]
    },
    "narrative": {
      "type": "string",
      "maxLength": 1000
    },
    "npcSpeech": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": -2,
        "maximum": 2
      }
    },
    "memoryCandidates": {
      "type": "array",
      "maxItems": 4
    },
    "safetyFlags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "engineAction": {
      "const": "none"
    }
  },
  "additionalProperties": false
}
