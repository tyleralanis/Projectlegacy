{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-legacy.action-proposal.schema.json",
  "type": "object",
  "required": [
    "requestId",
    "actorId",
    "actions",
    "confidence",
    "requiresConfirmation"
  ],
  "properties": {
    "requestId": {
      "type": "string"
    },
    "actorId": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requiresConfirmation": {
      "type": "boolean"
    },
    "clarification": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 240
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "verb",
          "targetIds",
          "parameters"
        ],
        "properties": {
          "verb": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "targetIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parameters": {
            "type": "object"
          },
          "destructive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
